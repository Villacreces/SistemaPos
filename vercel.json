{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/dashboard.php",
      "destination": "/api/dashboard.php"
    },
    {
      "source": "/clientes.php",
      "destination": "/api/clientes.php"
    },
    {
      "source": "/historial.php",
      "destination": "/api/historial.php"
    },
    {
      "source": "/backend/:path*",
      "destination": "/api/backend/:path*"
    }
  ]
}